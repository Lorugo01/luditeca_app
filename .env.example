# Este arquivo e apenas um modelo de referencia para --dart-define.
# O Flutter deste projeto le variaveis por compile-time (nao usa dotenv runtime).

APP_ENV=local
DATA_SOURCE=vps_api

# API/Media da VPS (preparado para migracao ou uso hibrido)
# Windows/desktop: localhost | Emulador Android: 10.0.2.2 | Telemóvel físico: IP LAN do PC
API_BASE_URL=http://localhost:3020
MEDIA_BASE_URL=http://localhost:3020/media
