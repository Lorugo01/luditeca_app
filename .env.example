# Copie para .env e ajuste. O ficheiro .env vai dentro do APK (asset).

APP_ENV=local
DATA_SOURCE=vps_api

# Produção — usado quando APP_ENV=production
API_BASE_URL=https://luditeca.com/api
MEDIA_BASE_URL=https://luditeca.com/media

# Local — opcional (defaults localhost:3020 se APP_ENV=local)
# API_BASE_URL=http://localhost:3020
# MEDIA_BASE_URL=http://localhost:3020/media
# ANDROID_DEV_HOST=127.0.0.1
