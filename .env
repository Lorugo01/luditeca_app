# APP_ENV: local | production
# - local      → API em localhost:3020 (ou URLs abaixo se definires)
# - production → usa API_BASE_URL e MEDIA_BASE_URL deste ficheiro

APP_ENV=production
DATA_SOURCE=vps_api

# Usado quando APP_ENV=production (obrigatório em produção)
API_BASE_URL=https://luditeca.com/api
MEDIA_BASE_URL=https://luditeca.com/media

# Opcional quando APP_ENV=local (defaults: localhost:3020)
# API_BASE_URL=http://192.168.1.10:3020
# MEDIA_BASE_URL=http://192.168.1.10:3020/media
# ANDROID_DEV_HOST=127.0.0.1
